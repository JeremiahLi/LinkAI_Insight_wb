# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# workbuddy local session data
/.workbuddy/

# python cache
__pycache__/
*.pyc
Python/_cache/

# typescript
*.tsbuildinfo
next-env.d.ts
.tmp-shots/
# 离线部署包体积大（4 万文件 / 1GB），已移出工程目录，此规则保留防误提交
scripts/offline-server-pkg-win64/
.next-*.log

# 数据库与图标的本地备份（如 prisma/dev.db.bak-YYYYMMDD），不入库
*.bak-*

# 检测模块的 CommonJS 编译产物（npm run detect:build 生成，供 scripts/*.cjs 使用）
.tmp-verify/

# Prisma 本地数据库不入库，原因有两个：
# 1. 体积 44MB，每次提交都是整块 blob，仓库会被撑爆；
# 2. UserSettings.settingsJson 里存着模型 API key，GitHub 的密钥扫描会直接拒绝推送。
# 新克隆后执行 npm run db:reset（db push + seed）重建。
prisma/dev.db
prisma/*.db
