generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  org       String   @default("")
  createdAt DateTime @default(now())

  projects  Project[]
  sessions  Session[]
}

model Agent {
  id          String   @id @default(cuid())
  name        String   @unique
  emoji       String   @default("🤖")
  description String   @default("")
  framework   String   @default("pi-coding-agent")
  version     String   @default("1.0.0")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects  Project[]
  sessions  Session[]
}

model Project {
  id        String   @id @default(cuid())
  name      String
  userId    String
  agentId   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  agent     Agent    @relation(fields: [agentId], references: [id])
  sessions  Session[]

  @@index([userId])
  @@index([agentId])
}

model Session {
  id               String   @id @default(cuid())
  projectId        String
  userId           String
  agentId          String
  status           String   @default("active")
  model            String   @default("")
  startTime        DateTime @default(now())
  endTime          DateTime?
  totalRounds      Int      @default(0)
  totalSpans       Int      @default(0)
  errorCount       Int      @default(0)
  totalInputTokens Int      @default(0)
  totalOutputTokens Int     @default(0)
  totalCacheReadTokens  Int  @default(0)
  totalCacheWriteTokens Int  @default(0)
  totalTokens      Int      @default(0)
  totalDuration    Int      @default(0)
  forkCount        Int      @default(0)
  rawData          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project          Project  @relation(fields: [projectId], references: [id])
  user             User     @relation(fields: [userId], references: [id])
  agent            Agent    @relation(fields: [agentId], references: [id])
  spans            Span[]

  @@index([userId, status, startTime])
  @@index([agentId, startTime])
  @@index([projectId, startTime])
}

model Skill {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String   @default("")
  skillMd      String   @default("")
  contentHash  String   @default("")
  version      Int      @default(1)
  lastSyncedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model BusinessMetric {
  id           String   @id @default(cuid())
  sessionId    String
  userId       String
  projectId    String
  agentId      String
  taskId       String   @unique
  durationMs   Int      @default(0)
  success      Boolean  @default(true)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  totalTokens  Int      @default(0)
  callCount    Int      @default(0)
  models       String   @default("[]")
  customData   String?
  createdAt    DateTime @default(now())

  @@index([sessionId])
  @@index([agentId, createdAt])
  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([createdAt])
}

model Span {
  id           String   @id @default(cuid())
  sessionId    String
  roundIndex   Int      @default(0)
  turnId       Int      @default(0)
  parentId     String?
  branchId     String?
  kind         String   @default("user")
  name         String   @default("")
  status       String   @default("success")
  startTime    Int      @default(0)
  duration     Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  cacheReadTokens  Int  @default(0)
  cacheWriteTokens Int  @default(0)
  totalTokens  Int      @default(0)
  model        String?
  input        String?
  output       String?
  error        String?
  llmThinkDuration    Int?
  agentReplyDuration  Int?
  toolDuration        Int?
  details     String?
  content     String?
  isForkPoint  Boolean  @default(false)
  createdAt    DateTime @default(now())

  session      Session  @relation(fields: [sessionId], references: [id], onDelete:Cascade)

  @@index([sessionId, roundIndex, turnId])
  @@index([parentId])
  @@index([branchId])
  @@index([name, createdAt])
}

model Experiment {
  id               String   @id @default(cuid())
  userId           String
  name             String
  type             String   @default("single")
  agentId          String
  evaluatorIdsJson String   @default("[]")
  evaluatorConfigJson String @default("{}")
  status           String   @default("draft")
  scope            String   @default("")
  watchMode        Boolean  @default(false)
  watchEnabledAt   DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cases            ExperimentCase[]
  comments         ExperimentEvalComment[]

  @@index([userId, createdAt])
  @@index([agentId])
  @@index([watchMode, agentId])
}

model ExperimentCase {
  id                   String   @id @default(cuid())
  experimentId         String
  experiment           Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  sessionId            String?
  input                String   @default("")
  actualOutput         String   @default("")
  referenceOutput      String?
  evaluatorContextJson String?
  createdAt            DateTime @default(now())

  results              ExperimentEvalResult[]

  @@index([experimentId])
  @@index([sessionId])
}

model ExperimentEvalResult {
  id           String   @id @default(cuid())
  experimentId String
  caseId       String
  case         ExperimentCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  evaluatorId  String
  status       String   @default("pending")
  verdict      String?
  summary      String?
  score        Float?
  pointsJson   String?
  evidenceJson String?
  humanScore   Float?
  humanReason  String?
  humanBy      String?
  humanAt      DateTime?
  errorMessage String?
  attempts     Int      @default(0)
  durationMs   Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([caseId, evaluatorId])
  @@index([experimentId, evaluatorId])
}

model ExperimentEvalComment {
  id           String   @id @default(cuid())
  experimentId String
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  caseId       String?
  resultId     String?
  user         String
  body         String
  createdAt    DateTime @default(now())

  @@index([experimentId, createdAt])
  @@index([caseId, createdAt])
  @@index([resultId, createdAt])
}

model UserSettings {
  id           String   @id @default(cuid())
  user         String   @unique
  settingsJson String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}


